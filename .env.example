# Copy to .env for local Node execution; Compose supplies isolated demo defaults.
APP_MODE=demo
DATABASE_URL=postgres://socialagent:socialagent@localhost:54329/socialagent_demo
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=demo-only-secret-change-before-live-32chars
STORAGE_DRIVER=local
ASSET_ROOT=.data/assets
# For local S3Mock (production uses real S3 credentials):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=socialagent-demo
# S3_ACCESS_KEY=S3RVER
# S3_SECRET_KEY=S3RVER
OUTBOUND_ENABLED=false
# Live requires a separate DB and bucket, randomly generated secrets, HTTPS, and explicit test account selection.
# TOKEN_ENCRYPTION_KEY=<32-byte-base64-key>
# TEXT_MODEL_BASE_URL=https://your-model-provider.example/v1
# TEXT_MODEL_API_KEY=<set-in-secret-manager>
# TEXT_MODEL_NAME=<your-model>
# ALLOWED_FEED_ENDPOINTS=https://feeds.example.com/industry.xml
# Live integrations (set only in deployment secrets):
# META_CLIENT_ID=
# META_CLIENT_SECRET=
# META_API_VERSION=<supported vNN.0>
# META_WEBHOOK_VERIFY_TOKEN=<random verification token>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=<supported YYYYMM>
# SEARCH_CONSOLE_TOKEN_COMPANY=<owned-property read token>
# First owner provision only: ALLOW_OWNER_PROVISION=true OWNER_EMAIL=... OWNER_PASSWORD=... ORG_NAME=...
